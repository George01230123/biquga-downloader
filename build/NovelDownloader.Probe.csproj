<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       布局探针（开发/CI 工具）：建真实窗体（屏幕外）量控件坐标，
       报告越界与重叠，并可传 shots 参数截屏。产物 dist\_layoutprobe.exe。

       它必须单独一个工程：探针有自己的 Main，混进 Tests 工程会和
       OfflineTests 的入口冲突（一个工程只能有一个入口）。
       build.bat 里对应同名的编译步骤，两条路径要保持同步。

       注意 XML 注释里不能出现连续两个减号（写命令行参数时要避开）。
       ============================================================ -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>_layoutprobe</AssemblyName>
    <RootNamespace>TomatoBiquga</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\dist\</OutputPath>
    <StartupObject>TomatoBiquga.LayoutProbe</StartupObject>
    <CodePage>65001</CodePage>
    <NoWarn>1591;0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\AssemblyInfo.cs" />
    <Compile Include="..\src\Program.cs" />
    <Compile Include="..\src\MainForm.cs" />
    <Compile Include="..\src\Common\*.cs" />
    <Compile Include="..\src\Sites\*.cs" />
    <Compile Include="..\tools\LayoutProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

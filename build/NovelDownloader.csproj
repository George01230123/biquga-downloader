<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       这个 csproj 存在的唯一目的：让 GitHub Actions（以及任何装了
       .NET SDK 的机器）能用 `dotnet build` 编出同一个 exe。

       本机零依赖编译走 build.bat（调用 Windows 自带的 csc.exe），
       那条路径不需要 SDK、不需要联网，是这个项目的卖点，永远保留。

       为什么是 net48：Windows 10 1903+ / 11 自带 .NET Framework 4.8，
       用户开箱即用，不需要装任何运行时。
       Microsoft.NETFramework.ReferenceAssemblies 提供 net48 的参考程序集，
       这样在 Linux/Windows 的任意 runner 上都能编译。
       ============================================================ -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- 与 csc.exe（.NET Framework 4.x 编译器）保持一致，别用 C# 8+ 语法 -->
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NovelDownloader</AssemblyName>
    <RootNamespace>TomatoBiquga</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\dist\</OutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 中文源码统一按 UTF-8 读，避免 runner 区域设置不同导致乱码 -->
    <CodePage>65001</CodePage>
    <NoWarn>1591;0618</NoWarn>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>

    <!-- ============================================================
         ★ 下面两项必须和 build.bat 里那条 csc 命令行**保持一致**，
           否则「本机编的」和「CI 编的」会是两个不同的程序。

         真实踩过的坑：v1.4.0 加 selftest 命令行开关时只在 build.bat 里做了
         （加了 tests\OfflineTests.cs 与 /define:SELFTEST），忘了改这里。
         结果本机 csc 编出来 365 KB、开关正常；
         CI 用 dotnet build 编出来 259 KB、**开关直接开了个窗** ——
         用户从 Release 下载的那份根本没有这个功能。
         而 CI 全绿、发布成功，**没有任何地方报错**。

         教训：编译清单有两处，改一处必须改另一处。
         ============================================================ -->
    <DefineConstants>SELFTEST</DefineConstants>
    <!-- OfflineTests.cs 自带一个 Main，必须指明入口 -->
    <StartupObject>TomatoBiquga.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Web.Extensions：解析番茄目录接口的 JSON -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\AssemblyInfo.cs" />
    <Compile Include="..\src\Program.cs" />
    <Compile Include="..\src\MainForm.cs" />
    <Compile Include="..\src\Common\*.cs" />
    <Compile Include="..\src\Sites\*.cs" />
    <!-- 与 build.bat 对齐：SELFTEST 开关需要它（见上面 DefineConstants 的说明） -->
    <Compile Include="..\tests\OfflineTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
